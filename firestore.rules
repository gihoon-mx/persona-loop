rules_version = '2';
// Persona Loop Firestore 보안 규칙 (v0.3 — 비공개 기본).
// 콘솔 > Firestore Database > 규칙 탭에 붙여넣고 게시한다.
//
// 원칙
//  - 모든 프로젝트 데이터(프로젝트·서베이·응답·페르소나·리뷰·세션)는 admin만 읽고 쓴다.
//  - 공개되는 것은 `public-forms/{surveyId}` 문서 하나뿐이다. 이 문서에는 응답 폼을 그리는 데
//    필요한 필드(title/description/questions/status)만 복사되며, 집계·응답수·응답 원본은 들어가지 않는다.
//    → 서베이 문서 자체를 공개하면 그 안의 aggregates(주관식 응답 원문)까지 함께 새어나가므로,
//      "무엇을 공개할지" 를 필드 단위로 정한 화이트리스트 문서를 따로 둔다.
//  - admin 목록은 `admins/{email}` 문서로 관리하며 웹 설정 화면에서 추가·삭제한다.
//  - OWNER는 규칙에 고정되어 있어 allowlist가 비어도 절대 잠기지 않는다 (부트스트랩 보장).
//    OWNER를 바꾸려면 아래 이메일과 packages/core/firebase-config.js의 OWNER_EMAIL을 함께 수정.
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower() == 'gihoon.mx@gmail.com';
    }

    function isAdmin() {
      return isOwner()
        || (request.auth != null
            && request.auth.token.email_verified == true
            && exists(/databases/$(database)/documents/admins/$(request.auth.token.email.lower())));
    }

    // 공개 폼이 열려 있는 서베이인지 — 응답 제출 허용 판정의 기준
    function formIsOpen(projectId, surveyId) {
      return exists(/databases/$(database)/documents/projects/$(projectId)/public-forms/$(surveyId))
        && get(/databases/$(database)/documents/projects/$(projectId)/public-forms/$(surveyId)).data.status == 'open';
    }

    // 익명 응답 제출의 형태 검증 — 필드 위조·대량 쓰기 남용 방지
    function isValidResponse() {
      return request.resource.data.keys().hasOnly(['answers', 'submittedAt', 'source', 'respondent'])
        && request.resource.data.answers is map
        && request.resource.data.answers.size() <= 100
        && request.resource.data.source == 'live'
        && request.resource.data.submittedAt == request.time
        && request.resource.data.respondent == null;
    }

    // ---------- 관리자 allowlist ----------
    match /admins/{email} {
      // 본인 문서는 스스로 확인 가능해야 로그인 직후 권한 판정이 된다
      allow get: if request.auth != null
        && (request.auth.token.email.lower() == email || isAdmin());
      allow list: if isAdmin();
      // 추가·삭제는 OWNER만 (권한 상승 체인 차단)
      allow create, update, delete: if isOwner();
    }

    // ---------- 프로젝트 데이터 ----------
    match /projects/{projectId} {
      allow read, write: if isAdmin();

      // 공개 응답 폼 — 유일하게 비로그인 접근이 가능한 문서.
      // get만 허용하므로 링크를 받은 사람도 다른 서베이의 존재를 알 수 없다.
      match /public-forms/{surveyId} {
        allow get: if isAdmin() || resource.data.status == 'open';
        allow list: if isAdmin();
        allow write: if isAdmin();
      }

      match /surveys/{surveyId} {
        allow read, write: if isAdmin();

        match /responses/{responseId} {
          // 응답 원본 열람·수정은 admin 전용 (개인정보가 들어갈 수 있는 유일한 컬렉션)
          allow read, update, delete: if isAdmin();
          allow create: if isAdmin()
            || (formIsOpen(projectId, surveyId) && isValidResponse());
        }
      }

      match /personas/{personaId} { allow read, write: if isAdmin(); }
      match /reviews/{reviewId}   { allow read, write: if isAdmin(); }
      match /sessions/{sessionId} { allow read, write: if isAdmin(); }
    }
  }
}
